@{
    ViewData["Title"] = "Inicio";
}

<div class="tg-hero mb-4">
    <div class="row align-items-center g-4">
        <div class="col-lg-7">
            <h1 class="display-5 mb-3">Portal interno de atención</h1>
            <p class="lead mb-4">
                Gestiona las solicitudes de servicio de <strong>TecnoGas Hogar</strong>: instalación,
                mantenimiento, revisión y atención de fugas en artefactos a gas.
            </p>
            <div class="d-flex flex-wrap gap-2">
                <a asp-controller="SolicitudServicio" asp-action="Create" class="btn btn-light btn-lg">Registrar solicitud</a>
                <a asp-controller="SolicitudServicio" asp-action="Index" class="btn btn-outline-light btn-lg">Ver listado</a>
            </div>
        </div>
        <div class="col-lg-5 d-none d-lg-flex justify-content-end">
            <div class="tg-hero-mark" aria-hidden="true">
                <span class="tg-hero-mark-ring"></span>
                <span class="tg-hero-mark-text">TG</span>
            </div>
        </div>
    </div>
</div>

<div class="row g-4 mt-1">
    <div class="col-lg-5">
        <div class="tg-card tg-card-feature p-4 h-100">
            <div class="d-flex gap-3">
                <div class="tg-feature-ico tg-feature-ico-primary" aria-hidden="true">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <circle cx="11" cy="11" r="7"></circle>
                        <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
                        <line x1="11" y1="8" x2="11" y2="14"></line>
                        <line x1="8" y1="11" x2="14" y2="11"></line>
                    </svg>
                </div>
                <div>
                    <div class="h4 fw-bold text-primary mb-2">Registro de solicitudes</div>
                    <p class="text-muted mb-0">
                        Captura los pedidos de servicio que llegan de los clientes de forma rápida y
                        ordenada, con validación de los datos obligatorios.
                    </p>
                </div>
            </div>
        </div>
    </div>
    <div class="col-lg-7">
        <div class="row g-4 h-100">
            <div class="col-md-6">
                <div class="tg-card p-4 h-100">
                    <div class="tg-feature-ico tg-feature-ico-soft mb-3" aria-hidden="true">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <line x1="8" y1="6" x2="21" y2="6"></line>
                            <line x1="8" y1="12" x2="21" y2="12"></line>
                            <line x1="8" y1="18" x2="21" y2="18"></line>
                            <line x1="3" y1="6" x2="3.01" y2="6"></line>
                            <line x1="3" y1="12" x2="3.01" y2="12"></line>
                            <line x1="3" y1="18" x2="3.01" y2="18"></line>
                        </svg>
                    </div>
                    <div class="h5 fw-bold text-primary mb-2">Listado centralizado</div>
                    <p class="text-muted mb-0">
                        Consulta todas las solicitudes en un solo lugar, ordenadas por fecha, sin
                        depender de notas en papel.
                    </p>
                </div>
            </div>
            <div class="col-md-6">
                <div class="tg-card p-4 h-100">
                    <div class="tg-feature-ico tg-feature-ico-soft mb-3" aria-hidden="true">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <ellipse cx="12" cy="5" rx="9" ry="3"></ellipse>
                            <path d="M21 12c0 1.66-4 3-9 3s-9-1.34-9-3"></path>
                            <path d="M3 5v14c0 1.66 4 3 9 3s9-1.34 9-3V5"></path>
                        </svg>
                    </div>
                    <div class="h5 fw-bold text-primary mb-2">Base de datos segura</div>
                    <p class="text-muted mb-0">
                        La información se persiste en SQLite mediante Entity Framework Core, lista
                        para evolucionar a un sistema más completo.
                    </p>
                </div>
            </div>
        </div>
    </div>
</div>
