@model IEnumerable<TecnoGas.Hogar.Models.SolicitudServicio>

@{
    ViewData["Title"] = "Listado de Solicitudes";
    var contador = Model.Count();
}

<div class="tg-page-head d-flex flex-wrap justify-content-between align-items-end">
    <div>
        <h1>Listado de Solicitudes</h1>
        <p class="lead">Consulta las solicitudes de servicio registradas</p>
    </div>
    <a asp-action="Create" class="btn btn-tg">+ Nueva solicitud</a>
</div>

@if (TempData["Mensaje"] != null)
{
    <div class="alert alert-tg-success alert-dismissible fade show" role="alert">
        @TempData["Mensaje"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

@functions {
    private static string NombreTipoServicio(string tipo) => tipo switch
    {
        "Instalacion" => "Instalación",
        "Revision" => "Revisión",
        _ => tipo
    };

    private static string ClaseBadge(string tipo) => tipo switch
    {
        "Instalacion" => "tg-badge-instalacion",
        "Mantenimiento" => "tg-badge-mantenimiento",
        "Revision" => "tg-badge-revision",
        "Fuga" => "tg-badge-fuga",
        _ => "bg-secondary text-white"
    };
}

@if (Model.Any())
{
    <div class="tg-card overflow-hidden">
        <div class="border-bottom px-4 py-3 d-flex justify-content-between align-items-center bg-white">
            <span class="text-muted small">
                <strong class="text-primary">@contador</strong> solicitud(es) registrada(s)
            </span>
            <span class="text-muted small">Ordenadas por fecha de registro</span>
        </div>
        <div class="table-responsive">
            <table class="table tg-table table-hover mb-0">
                <thead>
                    <tr>
                        <th>#</th>
                        <th>Cliente</th>
                        <th>Teléfono</th>
                        <th>Distrito</th>
                        <th>Tipo de servicio</th>
                        <th>Descripción</th>
                        <th>Fecha</th>
                    </tr>
                </thead>
                <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td class="fw-bold text-muted">#@item.Id</td>
                        <td class="fw-semibold">@item.Cliente</td>
                        <td>@item.Telefono</td>
                        <td>@item.Distrito</td>
                        <td>
                            <span class="tg-badge @ClaseBadge(item.TipoServicio)">
                                <span class="tg-dot" aria-hidden="true"></span>
                                @NombreTipoServicio(item.TipoServicio)
                            </span>
                        </td>
                        <td>@item.Descripcion</td>
                        <td class="text-muted">@item.FechaRegistro.ToString("dd/MM/yyyy HH:mm")</td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    </div>
}
else
{
    <div class="tg-card p-5 text-center">
        <div class="display-6 mb-3 text-muted">Sin solicitudes</div>
        <p class="text-muted mb-4">Aún no hay solicitudes registradas.</p>
        <a asp-action="Create" class="btn btn-tg">Registrar la primera solicitud</a>
    </div>
}
