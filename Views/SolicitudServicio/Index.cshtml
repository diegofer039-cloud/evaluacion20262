@model IEnumerable<TecnoGas.Hogar.Models.SolicitudServicio>

@{
    ViewData["Title"] = "Listado de Solicitudes";
}

<h1 class="mb-4">Listado de Solicitudes</h1>

@if (TempData["Mensaje"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @TempData["Mensaje"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<p>
    <a asp-action="Create" class="btn btn-primary">Registrar nueva solicitud</a>
</p>

<table class="table table-striped table-hover">
    <thead>
        <tr>
            <th>Id</th>
            <th>Cliente</th>
            <th>Teléfono</th>
            <th>Distrito</th>
            <th>Tipo de servicio</th>
            <th>Descripción</th>
            <th>Fecha de registro</th>
        </tr>
    </thead>
    <tbody>
    @foreach (var item in Model)
    {
        <tr>
            <td>@item.Id</td>
            <td>@item.Cliente</td>
            <td>@item.Telefono</td>
            <td>@item.Distrito</td>
            <td>@item.TipoServicio</td>
            <td>@item.Descripcion</td>
            <td>@item.FechaRegistro.ToString("dd/MM/yyyy HH:mm")</td>
        </tr>
    }
    </tbody>
</table>
