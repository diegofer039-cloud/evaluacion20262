@model TecnoGas.Hogar.Models.SolicitudServicio

@{
    ViewData["Title"] = "Registrar Solicitud";
}

<div class="tg-page-head">
    <h1>Registrar Solicitud de Servicio</h1>
    <p class="lead">Complete los datos del cliente y el servicio solicitado</p>
</div>

@if (TempData["Mensaje"] != null)
{
    <div class="alert alert-tg-success alert-dismissible fade show" role="alert">
        @TempData["Mensaje"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<div class="row">
    <div class="col-lg-8 col-xl-6">
        <div class="tg-card p-4">
            <form asp-action="Create" class="tg-form">
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                <div class="row g-3">
                    <div class="col-md-6">
                        <label asp-for="Cliente" class="form-label"></label>
                        <input asp-for="Cliente" class="form-control" placeholder="Nombre del cliente" />
                        <span asp-validation-for="Cliente" class="text-danger"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="Telefono" class="form-label"></label>
                        <input asp-for="Telefono" class="form-control" placeholder="Ej. 987654321" />
                        <span asp-validation-for="Telefono" class="text-danger"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="Distrito" class="form-label"></label>
                        <input asp-for="Distrito" class="form-control" placeholder="Distrito del cliente" />
                        <span asp-validation-for="Distrito" class="text-danger"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="TipoServicio" class="form-label"></label>
                        <select asp-for="TipoServicio" class="form-select">
                            <option value="">Seleccione un tipo</option>
                            <option value="Instalacion">Instalación</option>
                            <option value="Mantenimiento">Mantenimiento</option>
                            <option value="Revision">Revisión</option>
                            <option value="Fuga">Fuga</option>
                        </select>
                        <span asp-validation-for="TipoServicio" class="text-danger"></span>
                    </div>
                    <div class="col-12">
                        <label asp-for="Descripcion" class="form-label"></label>
                        <textarea asp-for="Descripcion" class="form-control" rows="3" placeholder="Detalle del servicio (opcional)"></textarea>
                        <span asp-validation-for="Descripcion" class="text-danger"></span>
                    </div>
                </div>

                <hr class="my-4" />

                <div class="d-flex gap-2 justify-content-end">
                    <a asp-action="Index" class="btn btn-tg-outline">Cancelar</a>
                    <button type="submit" class="btn btn-tg">Guardar solicitud</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }
}
